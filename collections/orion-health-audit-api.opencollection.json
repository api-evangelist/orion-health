{
  "opencollection": "1.0.0",
  "info": {
    "name": "Orion Health FHIR Alerts Audit API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.orionhealth.com/oauth2/authorize",
      "accessTokenUrl": "https://auth.orionhealth.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Orion Health Search audit logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.orionhealth.com/fhir/audit-logs",
            "params": [
              {
                "name": "patientId",
                "value": "",
                "type": "query"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query"
              },
              {
                "name": "action",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateFrom",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateTo",
                "value": "",
                "type": "query"
              },
              {
                "name": "outcome",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              }
            ]
          },
          "docs": "Search audit logs for data access and exchange events within the HIE network for compliance and accountability purposes."
        }
      ]
    }
  ],
  "bundled": true
}