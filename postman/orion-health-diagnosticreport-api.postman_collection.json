  "info": {
    "_postman_id": "16088317-8ffa-4e20-a8ee-5199189998b5",
    "name": "Orion Health FHIR Alerts DiagnosticReport API",
    "description": "The Orion Health FHIR API provides standards-based access to healthcare data using the HL7 FHIR (Fast Healthcare Interoperability Resources) specification. It enables healthcare organizations to read, search, create, and update clinical resources including patients, encounters, observations, conditions, medications, allergies, procedures, diagnostic reports, and care plans. The API conforms to FHIR R4 (v4.0.1) and supports both JSON and XML representations.\n\nContact Support:\n Name: Orion Health API Support\n Email: apisupport@orionhealth.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
